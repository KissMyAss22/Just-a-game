// Datamodel van Just a Game.
//
// Uitgangspunt: de server is de baas over de economie. Elke muntmutatie loopt
// via de Transaction-tabel (het grootboek), zodat duplicatie-bugs opspoorbaar
// zijn en spelers gecompenseerd kunnen worden.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Een account. Nu nog een gast-account op basis van een device-id; later
/// koppelbaar aan e-mail of Sign in with Apple.
model User {
  id        String   @id @default(cuid())
  deviceId  String   @unique
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
  player    Player?
}

model Player {
  id          String @id @default(cuid())
  userId      String @unique
  displayName String

  /// Vaste seed voor deterministische keuzes (bv. welke quests je krijgt).
  seed Int

  level Int    @default(1)
  xp    Int    @default(0)
  cash  BigInt @default(0)
  gems  Int    @default(0)

  /// Alles wat er ooit aan cash is bijgeschreven. Wordt door een rebirth
  /// bewust NIET gereset: de erfenisformule rekent hierop, waardoor elke
  /// volgende rebirth vanzelf meer opbrengst vraagt dan de vorige.
  lifetimeEarned BigInt @default(0)
  /// Erfenis die nog uitgegeven kan worden.
  erfenis        Int    @default(0)
  /// Erfenis die in totaal ooit is uitgekeerd.
  erfenisClaimed Int    @default(0)
  rebirthCount   Int    @default(0)

  propertyId String @default("squat")
  vehicleId  String @default("on_foot")

  /// Uiterlijk van je personage. Wordt altijd door normalizeAppearance()
  /// gehaald voordat het gebruikt wordt, dus rommel hier kan geen kwaad.
  appearance Json @default("{}")

  /// Laatst bekende positie in de stad (wereldcoördinaten in meters).
  x Float @default(0)
  z Float @default(0)

  /// Kluis: hier hoopt passief inkomen zich op tot je het ophaalt.
  vaultBalance BigInt   @default(0)
  /// Tot dit moment is het passieve inkomen bijgeschreven (servertijd).
  accruedAt    DateTime @default(now())

  /// Totaal afgelegde afstand in meters — voor quests en statistieken.
  distanceTotal Float @default(0)
  /// Tijdstip van de laatste positiemelding, voor de snelheidscontrole.
  positionAt    DateTime @default(now())
  /// Tijdstip van de laatste opgeraapte spawn, voor rate limiting.
  lastCollectAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  upgrades       PlayerUpgrade[]
  vehicles       PlayerVehicle[]
  boosts         PlayerBoost[]
  legacy         PlayerLegacy[]
  inventory      InventoryItem[]
  parkLoot       ParkLoot[]
  placements     Placement[]
  transactions   Transaction[]
  seasonProgress SeasonProgress[]
  questProgress  QuestProgress[]
  spawns         Spawn[]

  @@index([cash])
}

model PlayerUpgrade {
  playerId  String
  upgradeId String
  level     Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, upgradeId])
}

model PlayerVehicle {
  playerId   String
  vehicleId  String
  acquiredAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, vehicleId])
}

/// Items in je rugzak.
model InventoryItem {
  playerId String
  itemId   String
  quantity Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, itemId])
}

/// Wat je in Het Verlaten Park hebt gevonden maar nog niet veilig hebt gesteld.
///
/// Bewust een aparte tabel en niet je gewone rugzak. Buit uit het park telt pas
/// als je de landtong over bent gelopen; tot die tijd staat hij hier. Dat is
/// wat de wandeling terug spannend maakt, en het is de laag waar PvP straks op
/// aansluit: neergaan betekent dan dat deze rijen verdwijnen, zonder dat er
/// iets aan je base, je cash of je gewone rugzak verandert.
model ParkLoot {
  playerId String
  itemId   String
  quantity Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, itemId])
}

/// Een voorwerp dat op een echte plek in je woning staat.
///
/// Eén rij per voorwerp, niet per soort: twee lampen zijn twee rijen met elk
/// hun eigen positie. Alleen wat hier staat levert passief inkomen en flex op.
model Placement {
  id       String @id @default(cuid())
  playerId String
  itemId   String
  /// Cel linksboven, in de plattegrond van je woning.
  x        Int    @default(0)
  z        Int    @default(0)
  /// Kwartslagen met de klok mee: 0, 1, 2 of 3.
  rotation Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

/// Het grootboek: elke wijziging van cash of gems staat hier.
model Transaction {
  id        String   @id @default(cuid())
  playerId  String
  currency  String
  /// Positief = bijschrijving, negatief = afschrijving.
  amount    BigInt
  /// Waarom: 'sell', 'vault_collect', 'buy_upgrade', 'quest_reward', ...
  reason    String
  balance   BigInt
  meta      Json?
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

/// Permanente voordelen die met erfenis zijn gekocht. Overleeft een rebirth.
model PlayerLegacy {
  playerId String
  perkId   String
  level    Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, perkId])
}

/// Een lopende boost. Verlopen rijen worden opgeruimd bij het laden.
model PlayerBoost {
  id        String   @id @default(cuid())
  playerId  String
  boostId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, expiresAt])
}

/// Een item dat op straat ligt. De server bepaalt waar en wat.
model Spawn {
  id         String   @id @default(cuid())
  districtId String
  itemId     String
  rarity     String
  x          Float
  z          Float
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  collectedById String?
  collectedAt   DateTime?

  collectedBy Player? @relation(fields: [collectedById], references: [id], onDelete: SetNull)

  @@index([districtId, collectedAt, expiresAt])
  @@index([collectedAt, expiresAt])
}

model SeasonProgress {
  playerId       String
  seasonIndex    Int
  seasonXp       Int      @default(0)
  premium        Boolean  @default(false)
  claimedFree    Int[]    @default([])
  claimedPremium Int[]    @default([])
  updatedAt      DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, seasonIndex])
}

model QuestProgress {
  id          String   @id @default(cuid())
  playerId    String
  questId     String
  scope       String
  /// Dagnummer (daily) of weeknummer (weekly) waarop deze quest hoort.
  periodIndex Int
  progress    Int      @default(0)
  claimed     Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, questId, periodIndex])
  @@index([playerId, scope, periodIndex])
}
