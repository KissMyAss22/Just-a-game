{
  "name": "@game/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma generate && prisma migrate deploy && prisma db seed",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "dev": "prisma generate && prisma migrate deploy && tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@game/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7",
    "ws": "^8.21.3"
  }
}
