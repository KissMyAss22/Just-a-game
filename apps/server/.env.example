# Verbinding met de database uit infra/docker-compose.yml
DATABASE_URL="postgresql://game:game@localhost:5432/justagame"

# Zet dit op een lange willekeurige string. Wijzig je hem, dan moet iedereen
# opnieuw inloggen.
JWT_SECRET="verander-dit-in-een-lange-willekeurige-string"

# 0.0.0.0 zorgt dat je telefoon de server op je LAN kan bereiken.
HOST="0.0.0.0"
PORT="4000"

# Hoe vaak de spawner de stad bijvult, in seconden.
SPAWN_INTERVAL_SECONDS="20"

# Ontwikkelgereedschap in de app: teleport, vliegen, loopsnelheid en geld
# bijschrijven. Dit staat tijdens het ontwikkelen gewoon AAN; je hoeft hier
# niets voor te doen. In productie kan het niet aan, wat er ook staat.
# Wil je zien hoe de app zich zonder gedraagt, zet dit dan op "off".
DEV_TOOLS="on"
