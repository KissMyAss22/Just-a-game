{
  "name": "@game/mobile",
  "version": "0.1.0",
  "private": true,
  "//": "Dit project blijft bewust op Expo SDK 56. Expo Go in de App Store en Play Store loopt altijd achter op de nieuwste SDK; met SDK 57 gaf Expo Go 'Project is incompatible with this version of Expo Go'. Werk de expo-* en react-native-versies dus alleen bij als je overstapt op een eigen development build, of als Expo Go de nieuwere SDK ondersteunt.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform ios --output-dir .expo/bundle-check"
  },
  "dependencies": {
    "@game/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "^9.7.0",
    "expo": "~56.0.20",
    "expo-asset": "~56.0.23",
    "expo-constants": "~56.0.24",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "~56.0.10",
    "expo-gl": "~56.0.6",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.17",
    "expo-router": "~56.2.19",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.8.3",
    "three": "^0.185.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/three": "^0.185.0",
    "typescript": "~5.9.2"
  }
}
