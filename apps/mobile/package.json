{
  "name": "@game/mobile",
  "version": "0.1.0",
  "private": true,
  "//": "Dit project blijft bewust op Expo SDK 54, omdat Expo Go uit de App Store en Play Store die versie ondersteunt. Expo Go loopt altijd achter op de nieuwste SDK: met 56 en 57 gaf hij 'Project is incompatible with this version of Expo Go'. Werk expo-* en react-native dus alleen bij als je hebt gecontroleerd welke SDK jouw Expo Go aankan (staat in de app), of als je overstapt op een eigen development build.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform ios --output-dir .expo/bundle-check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@game/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "^9.7.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-gl": "~16.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "three": "^0.185.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.1",
    "@types/three": "^0.185.0",
    "typescript": "~5.9.2"
  }
}
