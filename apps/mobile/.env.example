# Het adres van de server op jouw computer. Zoek je LAN-IP op met:
#   macOS/Linux:  ipconfig getifaddr en0   of   hostname -I
#   Windows:      ipconfig
#
# Laat je dit leeg, dan gebruikt de app automatisch het IP van de Metro-server
# met poort 4000 — dat werkt meestal gewoon.
# EXPO_PUBLIC_API_URL=http://192.168.1.42:4000
