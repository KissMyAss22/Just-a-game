{
  "name": "just-a-game",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "balance": "pnpm --filter @game/shared balance",
    "build:shared": "pnpm --filter @game/shared build",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @game/server db:migrate",
    "db:studio": "pnpm --filter @game/server db:studio",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "dev:mobile": "pnpm --filter @game/mobile start",
    "dev:server": "pnpm --filter @game/server dev",
    "lint": "pnpm -r --if-present lint",
    "preview": "node scripts/render-preview.mjs",
    "sdk:check": "node scripts/sdk-check.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "smoke": "tsx scripts/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
